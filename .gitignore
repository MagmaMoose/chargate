# Claude Code
# last_output.txt is the flood-output target named in CLAUDE.md's [tooling] block.
# settings.local.json is per-developer overrides and must never be committed — it is
# only ignored here, not by anyone's personal global gitignore.
.claude/last_output.txt
.claude/settings.local.json

# JetBrains. Untracked but not ignored is the dangerous combination: it puts local IDE
# state (including per-user paths and run configs) one `git add -A` away from a public
# repo, and it shows up as noise in every `git status` while reviewing.
.idea/

# Written by the brimyr patch-coverage gate (pytest --cov-report=xml)
coverage.xml
